{
  "name": "chan-media-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser extension: scan 4chan boards/threads, select media, download into organized folders.",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs --production",
    "build:firefox": "node scripts/build.mjs --production --firefox",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:dom": "node tests/dom/run-dom-tests.mjs",
    "test:e2e": "node tests/dom/e2e.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.1",
    "playwright": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}